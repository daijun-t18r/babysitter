# Supabase (local dev values printed by `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# Service-role key (Supabase dashboard → Project Settings → API). Used ONLY by
# GDPR account deletion (DELETE /api/v1/me → Auth Admin API); app data erasure
# rides the auth.users → profiles ON DELETE CASCADE. Leave unset to disable
# account deletion (503).
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CHAT_MODEL=claude-sonnet-5
SAFETY_MODEL=claude-haiku-4-5-20251001

# App
ALLOWED_ORIGINS=http://localhost:3000
ENV=dev
LOG_LEVEL=INFO

# Voice (Phase 2). Same value goes in the Vapi assistant's custom-LLM
# X-Vapi-Secret header config; also signs the short-lived voice session
# tokens. Leave unset to disable voice (503 outside dev; anonymous dev mode
# with no persistence when ENV=dev).
VAPI_SHARED_SECRET=
